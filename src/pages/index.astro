---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Buffalo & WNY Web Design">
    <section class="hero">
        <!-- Image Slider -->
        <div class="hero-slider">
            <div class="slide active" style="background-image: url('/Img6.jpg');"></div>
            <div class="slide" style="background-image: url('/Img1.jpeg');"></div>
            <div class="slide" style="background-image: url('/Img3.jpeg');"></div>
            <div class="slide" style="background-image: url('/Img5.jpg');"></div>
        </div>
        
        <!-- Dark overlay so text is readable -->
        <div class="hero-overlay"></div>
        
        <!-- Hero Content -->
        <div class="hero-content">
            <h1>Shine bright, locally.</h1>
            <p>We help Buffalo and Upstate Western NY businesses turn clicks into customers with stunning, high-converting websites.</p>
            <div class="hero-buttons">
                <a href="/pricing" class="btn btn-primary">Get Started</a>
                <a href="/demo" class="btn btn-outline">Have a demo code?</a>
            </div>
            <div class="hero-badges">
                Helping WNY small businesses stand out and grow online.
            </div>
        </div>
    </section>

    <section class="section" id="services">
        <h2>How We Help You Grow</h2>
        <div class="cards">
            <div class="card">
                <h3>For Local Businesses</h3>
                <p>Find more customers and phone calls through our website. Let locals find you first.</p>
                <a href="mailto:LBWebsiteServices@gmail.com" class="btn btn-primary">Contact us!</a>
            </div>
            <div class="card">
                <h3>For Demos</h3>
                <p>Have you been reached out to by us and have received a Demo Code? Click here to view!</p>
                <a href="/demo" class="btn btn-outline">View Demos</a>
            </div>
             <div class="card">
                <h3>Pricing</h3>
                <p>Do you want to learn more about our pricing? Our affordable prices will help you satisfy your own needs.</p>
                <a href="/pricing" class="btn btn-outline">View Pricing</a>
            </div>
        </div>
    </section>
</Layout>

<script is:inline>
    const slides = document.querySelectorAll('.hero-slider .slide');
    let currentSlide = 0;
    
    if (slides.length > 0) {
        setInterval(() => {
            // Remove active class from current slide
            slides[currentSlide].classList.remove('active');
            
            // Move to next slide, loop back to 0 if at the end
            currentSlide = (currentSlide + 1) % slides.length;
            
            // Add active class to the new slide
            slides[currentSlide].classList.add('active');
        }, 5000); // 5000 = 5 seconds per image
    }
</script>
