---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About Us">
    <section class="section">
        <div class="about-content">
            <h2>Who We Are</h2>
            <p>LB Website Services was founded by high school freelancers Leo and Bill. We provide custom website solutions and guarantee high-quality results. As locals ourselves, we are dedicated to seeing Western New York businesses thrive in a digital world.</p>
            
            <div class="values">
                <h3>Our Core Values</h3>
                <ul>
                    <li><strong>Integrity:</strong> Maintaining honesty and transparency in everything we do.</li>
                    <li><strong>Innovation:</strong> Embracing new ideas and continuous improvement.</li>
                    <li><strong>Excellence:</strong> Striving for the highest quality in our projects.</li>
                </ul>
            </div>
        </div>
    </section>
</Layout>
