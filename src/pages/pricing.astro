---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Pricing">
    <section class="section pricing-bg">
        <h2>Simple, Transparent Pricing</h2>
        <div class="pricing-cards">
            <div class="price-card">
                <h3>Upfront Cost</h3>
                <div class="price">$400</div>
                <p>Initial investment covers full website development, setup, and ensures a high-quality site designed to attract new customers.</p>
                <a href="mailto:LBWebsiteServices@gmail.com" class="btn btn-primary">Get Started</a>
            </div>
            <div class="price-card">
                <h3>Monthly Fees</h3>
                <div class="price">$10</div>
                <p>Covers ongoing hosting, security updates, and minor content changes to match your business's growth and needs.</p>
                <a href="mailto:LBWebsiteServices@gmail.com" class="btn btn-outline">Learn More</a>
            </div>
        </div>
    </section>
</Layout>